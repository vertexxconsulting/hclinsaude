# Neon PostgreSQL
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# Auth - bcrypt hash of admin password
# Generate: node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA', 10))"
ADMIN_PASSWORD_HASH=$2a$10$ExemploHashQueDeveSerSubstituido

# Session secret for JWT
SESSION_SECRET=change-this-to-long-random-string

# JWT expires in (default 7d)
JWT_EXPIRES_IN=7d
